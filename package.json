{
  "name": "sveltekit-electron",
  "version": "0.0.1",
  "private": true,
  "main": "src/electron/index.js",
  "scripts": {
    "build:electron": "electron-builder -m --config build.config.json",
    "build:svelte": "vite build",
    "build": "npm run build:svelte && npm run build:electron",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev:electron": "nodemon --watch src/electron --exec \"electron --trace-warnings ./src/electron/index.js\"",
    "dev:svelte": "vite dev",
    "dev": "concurrently --kill-others \"npm run dev:svelte\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.15.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/eslint": "^9.6.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.46.1",
    "nodemon": "^3.1.9",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.2",
    "svelte": "^5.17.3",
    "svelte-check": "^4.1.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  },
  "type": "module"
}
